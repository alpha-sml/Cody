# Cody AI Harness - Environment Configuration
# The evaluator sets AI_API_KEY. Provider-specific keys are for local dev only.
# Supported evaluation providers: deepseek (default), qwen

AI_API_KEY=

# --- Provider / Model Selection ---
# CODY_PROVIDER=deepseek          # Options: deepseek, qwen
# CODY_MODEL=deepseek-flash    # Default: deepseek-flash (deepseek) | qwen-plus (qwen)
#                                 # If CODY_PROVIDER is absent, provider is inferred from model prefix.
# CODY_LOCKED_MODEL=              # Pins the model; any conflicting override is rejected.

# --- Custom API Endpoints (optional) ---
# Override the default provider base URLs (useful when routing through a proxy).
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- Local Development Fallback Keys ---
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# --- Offline / CI mode ---
MOCK_MODEL=false
